# Local demonstration defaults. Change all credentials before deployment.
POSTGRES_PASSWORD=crm-local-demo
KC_ADMIN=bootstrap-admin
KC_ADMIN_PASSWORD=change-me-local-demo
FRONTEND_PORT=3000
BACKEND_PORT=8000
KEYCLOAK_PORT=8080
MAX_UPLOAD_MB=20
SEED_DEMO=true
# Non-Docker backend (Compose overrides internal hostnames):
DATABASE_URL=postgresql+psycopg://crm:crm-local-demo@localhost:5432/crm
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_ISSUER=http://localhost:8080/realms/rostelecom-it-school
KEYCLOAK_AUDIENCE=crm-backend
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data/v2
INTEGRATION_MODE=mock
INTEGRATION_ALLOWED_HOSTS=
LMS_API_URL=
LMS_API_TOKEN=
WEBSITE_API_URL=
WEBSITE_API_TOKEN=
